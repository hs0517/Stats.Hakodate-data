{
 "@context": "../context.jsonld",
 "@graph": [
  {
   "id": "CS01",
   "type": "CodeScheme",
   "name": {
    "ja": "アノテーションにおける参照プロセスの分類",
    "en": "Classification of Reference Processes in Annotations"
   },
   "version": "1.0",
   "categories": [
    {
     "id": "CS01/A",
     "type": "CodeCategory",
     "notation": "A",
     "label": {
      "ja": "カラム（表頭）、あるいはレコード（表側）単位でフィールド値に着目し、その値の大きさや、その変化や傾向に言及するもの",
      "en": "Focuses on field values per column (box head) or record (stub) and mentions their magnitude, changes, or trends"
     }
    },
    {
     "id": "CS01/B",
     "type": "CodeCategory",
     "notation": "B",
     "label": {
      "ja": "複数のカラム、あるいはレコード間で、それぞれに含まれる複数のフィールド値の変化の傾向に言及するもの",
      "en": "Mentions trends in changes of multiple field values contained in multiple columns or records"
     }
    },
    {
     "id": "CS01/C",
     "type": "CodeCategory",
     "notation": "C",
     "label": {
      "ja": "カラムあるいはレコードに含まれるフィールド値に着目し、そのカラム名やレコード名の意味を解釈した上でその値について言及するもの",
      "en": "Focuses on field values in a column or record and comments on them after interpreting the meaning of the column or record name"
     }
    },
    {
     "id": "CS01/D",
     "type": "CodeCategory",
     "notation": "D",
     "label": {
      "ja": "1個あるいは複数個のフィールド値に着目した上で、それを含むカラムあるいはレコードの特徴やそれが示唆するところについて言及するもの",
      "en": "Focuses on one or more field values and comments on the features of, or what is suggested by, the column or record that contains them"
     }
    },
    {
     "id": "CS01/F",
     "type": "CodeCategory",
     "notation": "F",
     "label": {
      "ja": "カラム（表頭）名、あるいはレコード（表側）名に着目しその解釈を試みたりそれに疑問を呈するもの",
      "en": "Focuses on column (box head) or record (stub) names and tries to interpret or questions them"
     }
    },
    {
     "id": "CS01/G",
     "type": "CodeCategory",
     "notation": "G",
     "label": {
      "ja": "表体の構造やレイアウトに着目するもの",
      "en": "Focuses on the structure or layout of the table body"
     }
    },
    {
     "id": "CS01/H",
     "type": "CodeCategory",
     "notation": "H",
     "label": {
      "ja": "表全体のフィールド値に対するアノテーション",
      "en": "Annotation on the field values of the whole table"
     }
    },
    {
     "id": "CS01/I",
     "type": "CodeCategory",
     "notation": "I",
     "label": {
      "ja": "統計表中の記号の使われ方に対する疑問や解釈",
      "en": "Questions or interpretations of how symbols are used in the statistical table"
     }
    },
    {
     "id": "CS01/J",
     "type": "CodeCategory",
     "notation": "J",
     "label": {
      "ja": "統計表の注釈や脚注に、注意や疑問を呈するもの",
      "en": "Calls attention to or questions notes or footnotes of the statistical table"
     }
    },
    {
     "id": "CS01/K",
     "type": "CodeCategory",
     "notation": "K",
     "label": {
      "ja": "統計表に含まれていない（カラムやレコードとしての）属性に言及（要望）するもの",
      "en": "Mentions attributes (as columns or records) not included in the statistical table"
     }
    },
    {
     "id": "CS01/L",
     "type": "CodeCategory",
     "notation": "L",
     "label": {
      "ja": "表題に言及するもの",
      "en": "Mentions the table title"
     }
    },
    {
     "id": "CS01/M",
     "type": "CodeCategory",
     "notation": "M",
     "label": {
      "ja": "統計表中の単位に着目するもの",
      "en": "Focuses on units in the statistical table"
     }
    }
   ],
   "codes": [
    {
     "id": "CS01/C001",
     "type": "AnalysisCode",
     "notation": "C001",
     "label": {
      "ja": "2つのカラム間でそれぞれ1つのフィールド値同士を比較",
      "en": "Compares one field value each between two columns"
     },
     "category": "CS01/A"
    },
    {
     "id": "CS01/C002",
     "type": "AnalysisCode",
     "notation": "C002",
     "label": {
      "ja": "2つのカラム間でそれぞれ複数のフィールド値同士を比較",
      "en": "Compares multiple field values each between two columns"
     },
     "category": "CS01/A"
    },
    {
     "id": "CS01/C003",
     "type": "AnalysisCode",
     "notation": "C003",
     "label": {
      "ja": "2つ（前後）のレコード間でそれぞれ複数のフィールド値同士を比較",
      "en": "Compares multiple field values each between two (adjacent) records"
     },
     "category": "CS01/A"
    },
    {
     "id": "CS01/C004",
     "type": "AnalysisCode",
     "notation": "C004",
     "label": {
      "ja": "2つ（前後）のレコード間でそれぞれ1つのフィールド値同士を比較",
      "en": "Compares one field value each between two (adjacent) records"
     },
     "category": "CS01/D"
    },
    {
     "id": "CS01/C005",
     "type": "AnalysisCode",
     "notation": "C005",
     "label": {
      "ja": "複数のカラム間でそれぞれ複数のフィールド値同士を比較",
      "en": "Compares multiple field values each across multiple columns"
     },
     "category": "CS01/A"
    },
    {
     "id": "CS01/C006",
     "type": "AnalysisCode",
     "notation": "C006",
     "label": {
      "ja": "1つのフィールド値とカラムの全体のフィールド値を比較",
      "en": "Compares one field value with all field values of the column"
     },
     "category": "CS01/A"
    },
    {
     "id": "CS01/C007",
     "type": "AnalysisCode",
     "notation": "C007",
     "label": {
      "ja": "特定のカラム名（複数のカラム）を見てそのフィールド値の傾向に言及",
      "en": "Looks at specific column name(s) and mentions the trend of their field values"
     },
     "category": "CS01/D"
    },
    {
     "id": "CS01/C008",
     "type": "AnalysisCode",
     "notation": "C008",
     "label": {
      "ja": "複数のカラムにまたがる構造（レイアウト）を解釈",
      "en": "Interprets a structure (layout) spanning multiple columns"
     },
     "category": "CS01/G"
    },
    {
     "id": "CS01/C009",
     "type": "AnalysisCode",
     "notation": "C009",
     "label": {
      "ja": "同じレコードの複数のカラム間の値の関係に疑問/仮説を提示",
      "en": "Raises a question/hypothesis about the relationship between values in multiple columns of the same record"
     },
     "category": "CS01/D"
    },
    {
     "id": "CS01/C010",
     "type": "AnalysisCode",
     "notation": "C010",
     "label": {
      "ja": "特定のカラムのフィールド値の大きさに常識的見地から言及（勝手に推測）",
      "en": "Mentions the magnitude of field values in a specific column from a common-sense standpoint (own guess)"
     }
    },
    {
     "id": "CS01/C011",
     "type": "AnalysisCode",
     "notation": "C011",
     "label": {
      "ja": "全てのカラム名（地名）と現状との関連付けへの疑問を提示",
      "en": "Questions how all column names (place names) relate to the present day"
     },
     "category": "CS01/F"
    },
    {
     "id": "CS01/C012",
     "type": "AnalysisCode",
     "notation": "C012",
     "label": {
      "ja": "特定のカラムのフィールド値に対して推察される状況描写に言及",
      "en": "Describes a situation inferred from field values in a specific column"
     }
    },
    {
     "id": "CS01/C013",
     "type": "AnalysisCode",
     "notation": "C013",
     "label": {
      "ja": "文字の解釈（特定のカラムの値の単位）",
      "en": "Interprets characters (the unit of values in a specific column)"
     },
     "category": "CS01/M"
    },
    {
     "id": "CS01/C014",
     "type": "AnalysisCode",
     "notation": "C014",
     "label": {
      "ja": "特定のカラム名（表頭）に注目",
      "en": "Focuses on a specific column name (box head)"
     },
     "category": "CS01/F"
    },
    {
     "id": "CS01/C015",
     "type": "AnalysisCode",
     "notation": "C015",
     "label": {
      "ja": "表外の注釈（データの出典/記号の使い方）を解釈し注意喚起",
      "en": "Interprets notes outside the table body (data source / use of symbols) and calls attention to them"
     },
     "category": "CS01/J"
    },
    {
     "id": "CS01/C016",
     "type": "AnalysisCode",
     "notation": "C016",
     "label": {
      "ja": "表体の特定範囲（値がないところ）に注目",
      "en": "Focuses on a specific area of the table body (where values are missing)"
     },
     "category": "CS01/G"
    },
    {
     "id": "CS01/C017",
     "type": "AnalysisCode",
     "notation": "C017",
     "label": {
      "ja": "特定のレコードの値（年）の欠損に言及",
      "en": "Mentions missing values (years) in a specific record"
     }
    },
    {
     "id": "CS01/C018",
     "type": "AnalysisCode",
     "notation": "C018",
     "label": {
      "ja": "表中にはない属性とその値に対する要望や理由の推察",
      "en": "Requests an attribute and its values not in the table, or infers why they are absent"
     },
     "category": "CS01/K"
    },
    {
     "id": "CS01/C019",
     "type": "AnalysisCode",
     "notation": "C019",
     "label": {
      "ja": "特定のカラム名の解釈",
      "en": "Interprets a specific column name"
     },
     "category": "CS01/F"
    },
    {
     "id": "CS01/C020",
     "type": "AnalysisCode",
     "notation": "C020",
     "label": {
      "ja": "特定のカラム名（複数のカラム）を見てたまたま見つけたであろうフィールド値の変化に言及",
      "en": "Looks at specific column name(s) and mentions a change in field values found by chance"
     },
     "category": "CS01/D"
    },
    {
     "id": "CS01/C021",
     "type": "AnalysisCode",
     "notation": "C021",
     "label": {
      "ja": "特定のカラムのフィールド値の変化/傾向に対して推察される状況描写（他のデータとか）に言及",
      "en": "Describes a situation (e.g., other data) inferred from the change/trend of field values in a specific column"
     }
    },
    {
     "id": "CS01/C022",
     "type": "AnalysisCode",
     "notation": "C022",
     "label": {
      "ja": "不明、謎、わからない",
      "en": "Unclear, puzzling, or not understood"
     }
    },
    {
     "id": "CS01/C023",
     "type": "AnalysisCode",
     "notation": "C023",
     "label": {
      "ja": "カラムに無関係に値の増えてるところ/減ってるところに注目",
      "en": "Focuses on where values increase/decrease regardless of column"
     },
     "category": "CS01/A"
    },
    {
     "id": "CS01/C024",
     "type": "AnalysisCode",
     "notation": "C024",
     "label": {
      "ja": "表中の注釈に疑問を提示",
      "en": "Raises a question about notes in the table"
     },
     "category": "CS01/J"
    },
    {
     "id": "CS01/C025",
     "type": "AnalysisCode",
     "notation": "C025",
     "label": {
      "ja": "複数のカラム間でそれぞれ複数のフィールド値の変化の傾向（正負の相関？）の関連性に注目/疑問を提示",
      "en": "Focuses on / questions the relationship (positive or negative correlation?) between trends of multiple field values across multiple columns"
     },
     "category": "CS01/B"
    },
    {
     "id": "CS01/C026",
     "type": "AnalysisCode",
     "notation": "C026",
     "label": {
      "ja": "表題に注目（意味不明教えて）",
