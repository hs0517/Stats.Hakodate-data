     "category": "CS01/M"
    },
    {
     "id": "CS01/C030",
     "type": "AnalysisCode",
     "notation": "C030",
     "label": {
      "ja": "単位から推察される状況描写に言及",
      "en": "Describes a situation inferred from the unit"
     },
     "category": "CS01/M"
    },
    {
     "id": "CS01/C031",
     "type": "AnalysisCode",
     "notation": "C031",
     "label": {
