     },
     "category": "CS01/A"
    },
    {
     "id": "CS01/C032",
     "type": "AnalysisCode",
     "notation": "C032",
     "label": {
      "ja": "特定のレコード名（複数のレコード）を見てそのフィールド値の傾向に言及",
      "en": "Looks at specific record name(s) and mentions the trend of their field values"
     },
     "category": "CS01/A"
    },
    {
     "id": "CS01/C033",
     "type": "AnalysisCode",
     "notation": "C033",
     "label": {
      "ja": "特定のカラムのフィールド値に対して当時の状況との関連付けへの疑問/推察",
      "en": "Questions/infers how field values in a specific column relate to the situation at the time"
     }
    },
    {
     "id": "CS01/C034",
     "type": "AnalysisCode",
     "notation": "C034",
     "label": {
      "ja": "表側の項目名に注目（規則性からの逸脱に言及）",
