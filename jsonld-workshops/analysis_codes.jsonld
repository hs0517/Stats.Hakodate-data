     "category": "CS01/G"
    },
    {
     "id": "CS01/C037",
     "type": "AnalysisCode",
     "notation": "C037",
     "label": {
      "ja": "特定のカラムのフィールド値の大きさに対して現状の常識的価値解釈から言及",
