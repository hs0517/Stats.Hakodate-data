     },
     "category": "CS01/F"
    },
    {
     "id": "CS01/C035",
     "type": "AnalysisCode",
     "notation": "C035",
     "label": {
      "ja": "表外の注釈を解釈し疑問を提示",
      "en": "Interprets notes outside the table body and raises a question"
     },
     "category": "CS01/J"
    },
    {
     "id": "CS01/C036",
     "type": "AnalysisCode",
     "notation": "C036",
     "label": {
      "ja": "複数のカラムにまたがる構造（レイアウト）があるレコードから変化していることに着目しその背景を推察",
