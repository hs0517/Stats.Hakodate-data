    "WrittenAnnotation"
   ],
   "created_in": "SUM002-3",
   "annotated_by": "P03",
   "value": {
    "ja": "分量すごい増えているのに、金額はあまり増えてない。毎年、単価ダダ下がり。",
    "en": "The quantity goes way up, but the amount of money hardly increases. The unit price is dropping like crazy every year."
   },
   "annotation_timing": "in_session",
   "annotated_on": [
    "PAG0082"
   ],
